---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { withBase } from "../utils/helpers";

type LayoutProps = {
  pageTitle: string;
  activePage: string;
};
const { pageTitle, activePage } = Astro.props as LayoutProps;
---

<!doctype html>
<html lang="es" class="antialiased break-words">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href={withBase("/space-ahead-logo.png")} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    
    <!-- Hoja de estilos vinculada correctamente con base path -->
    <link rel="stylesheet" href={withBase("/src/styles/global.css")} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sigmar&family=Kanit:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="max-w-3xl mx-auto min-h-screen">
      <Nav activePage={activePage} />
      <slot />
      <Footer />
    </main>
  </body>
</html>