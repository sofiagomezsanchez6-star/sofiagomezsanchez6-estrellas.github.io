---
import { Image } from "astro:assets";
import MainLayout from "../layouts/MainLayout.astro";
import siteConfig from "../site.config";
import avatarImage from "../assets/images/sofia.jpg";

const presentation = siteConfig.presentation;
---

<MainLayout
  activePage="presentación"
  pageTitle={siteConfig.title + " | Presentación"}
>
  <div class="page-content">
    <h1 class="sigmar-ff text-balance">{presentation?.title}</h1>

    <div
      class="flex flex-col items-center gap-8 sm:flex-row sm:items-start sm:gap-10"
    >
      <div class="w-40 shrink-0 sm:w-48">
        <Image
          width={400}
          height={400}
          loading="eager"
          class="rounded-full mx-auto border-2 border-space-red dark:border-space-yellow"
          src={avatarImage}
          alt={presentation?.avatar?.alt || "Foto de perfil"}
        />
        <p class="kanit-light text-xs text-center mt-2 opacity-70">
        </p>
      </div>

      <div class="flex flex-col gap-4 text-left w-full">
        <p class="kanit-light text-balance">
          {presentation?.text}
        </p>

        {
          presentation?.videoUrl && (
            <div class="video-wrapper w-full rounded-2xl overflow-hidden">
              <iframe
                src={presentation.videoUrl}
                title="Video de presentación"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              />
            </div>
          )
        }
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .video-wrapper {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* aspect ratio 16:9 */
  }
  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
