---
import MainLayout from "../../layouts/MainLayout.astro";
import siteConfig from "../../site.config";
import { withBase } from "../../utils/helpers";
---

<MainLayout activePage="evidencias" pageTitle={siteConfig.title + " | Evidencias · Proyecto"}>
  <div class="page-content">
    <a href={withBase("/evidencias")} class="kanit-light text-sm">&larr; Volver a Evidencias</a>
    <h1 class="sigmar-ff text-balance">Proyecto</h1>
    <p class="kanit-light text-balance">
      Próximamente: documentación general y entregable final del proyecto.
    </p>
    <div class="placeholder-box kanit-light">
      Esta sección está vacía por ahora. Agrega aquí un resumen del proyecto,
      enlaces a repositorios o documentos, y capturas del resultado final.
    </div>
  </div>
</MainLayout>

<style>
  .placeholder-box {
    margin-top: 2rem;
    border: 2px dashed var(--space-red);
    border-radius: 1rem;
    padding: 2rem;
    text-align: left;
    opacity: 0.8;
  }
  html.dark .placeholder-box {
    border-color: var(--space-yellow);
  }
</style>
